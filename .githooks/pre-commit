#!/usr/bin/env bash
# =============================================================================
# Pre-Commit Hook — Conventional Commits Validator
# =============================================================================
# PURPOSE:
#   Validates that the commit message follows the Conventional Commits
#   specification before allowing the commit to proceed.
#
# INSTALLATION:
#   cp .githooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or configure globally for all repos:
#   git config --global core.hooksPath .githooks
# =============================================================================

set -e

# ── Colors ────────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ── Conventional Commit Pattern ───────────────────────────────────────────────
# Matches: type(scope): subject
# Types: feat, fix, docs, style, refactor, perf, test, chore, ci, revert
COMMIT_MSG_FILE="$1"

# When called as pre-commit (not commit-msg), check COMMIT_EDITMSG
if [ -z "$COMMIT_MSG_FILE" ]; then
  COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
fi

# Read only the first line (subject line)
COMMIT_MSG=$(head -n1 "$COMMIT_MSG_FILE" 2>/dev/null || echo "")

# Skip merge commits and empty messages
if echo "$COMMIT_MSG" | grep -qE "^Merge (branch|pull request|remote-tracking)"; then
  echo -e "${BLUE}ℹ Merge commit detected — skipping Conventional Commits check.${NC}"
  exit 0
fi

if [ -z "$COMMIT_MSG" ] || echo "$COMMIT_MSG" | grep -qE "^#"; then
  echo -e "${RED}✗ Commit message is empty.${NC}"
  exit 1
fi

# ── Validate Format ───────────────────────────────────────────────────────────
PATTERN="^(feat|fix|docs|style|refactor|perf|test|chore|ci|revert)(\([a-z0-9._-]+\))?(!)?: .{1,72}$"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo -e "${RED}╔══════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║         ✗  COMMIT REJECTED — Invalid commit message          ║${NC}"
  echo -e "${RED}╚══════════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "  ${YELLOW}Your message:${NC} \"$COMMIT_MSG\""
  echo ""
  echo -e "  ${BLUE}Required format:${NC}"
  echo -e "    ${GREEN}<type>(<scope>): <subject>${NC}"
  echo ""
  echo -e "  ${BLUE}Valid types:${NC}"
  echo -e "    feat, fix, docs, style, refactor, perf, test, chore, ci, revert"
  echo ""
  echo -e "  ${BLUE}Examples:${NC}"
  echo -e "    ${GREEN}feat(auth): add JWT token refresh endpoint${NC}"
  echo -e "    ${GREEN}fix(ui): correct button alignment on mobile viewport${NC}"
  echo -e "    ${GREEN}docs: update installation instructions in README${NC}"
  echo -e "    ${GREEN}chore(deps): upgrade node from 18 to 20${NC}"
  echo ""
  echo -e "  ${YELLOW}Tip:${NC} Run 'git config commit.template .gitmessage' to use the"
  echo -e "       commit template as a guide."
  echo ""
  exit 1
fi

# ── Subject Line Length Check ─────────────────────────────────────────────────
SUBJECT_LENGTH=${#COMMIT_MSG}
if [ "$SUBJECT_LENGTH" -gt 72 ]; then
  echo ""
  echo -e "${RED}✗ Subject line exceeds 72 characters (${SUBJECT_LENGTH} chars).${NC}"
  echo -e "  Please shorten your commit subject."
  echo ""
  exit 1
fi

# ── No Period at End ──────────────────────────────────────────────────────────
if echo "$COMMIT_MSG" | grep -qE "\.$"; then
  echo ""
  echo -e "${RED}✗ Subject line must not end with a period.${NC}"
  echo ""
  exit 1
fi

